$dq = new DelayQueue(\'close_order\', [
  \'host\' =&gt; \'127.0.0.1\',
  \'port\' =&gt; 6379,
  \'auth\' =&gt; \'\',
  \'timeout\' =&gt; 60,
]);
while (true) {
  $dq-&gt;run();
  usleep(100000);
}
