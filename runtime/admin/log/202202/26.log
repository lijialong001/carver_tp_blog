[2022-02-26T17:23:33+08:00][sql] UPDATE `carver_article`  SET `article_id` = 53 , `article_title` = 'Linux——通过docker搭建禅道' , `article_desc` = 'Linux——通过docker搭建禅道' , `article_content` = '<h1 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 700; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 24px; color: rgb(79, 79, 79); line-height: 32px; overflow-wrap: break-word;\">一、下载并安装docker</h1><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><a href=\"http://www.lijialong.site/web/ArticleUser/articleDetail.html?article_id=52\">http://www.lijialong.site/web/ArticleUser/articleDetail.html?article_id=52</a><a href=\"http://www.lijialong.site/web/ArticleUser/articleDetail.html?article_id=52\"></a></p><h1 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 700; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 24px; color: rgb(79, 79, 79); line-height: 32px; overflow-wrap: break-word;\">二、下载禅道</h1><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>docker pull idoop/zentao</b></span></font></p><div><h1 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 700; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 24px; color: rgb(79, 79, 79); line-height: 32px; overflow-wrap: break-word;\">三、运行镜像</h1><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>docker run -d -p 8183:80 -p 8184:3306 -e ADMINER_USER=\"root\" -e ADMINER_PASSWD=\"password\" -e BIND_ADDRESS=\"false\"&nbsp; --name zentao idoop/zentao:latest</b></span></font></p></div><div><h1 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 700; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 24px; color: rgb(79, 79, 79); line-height: 32px; overflow-wrap: break-word;\">四、查看启动日志，可以看到启动成功</h1><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>docker logs -f zentao</b></span></font></p><h1 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 700; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 24px; color: rgb(79, 79, 79); line-height: 32px; overflow-wrap: break-word;\">五、浏览器访问</h1><p style=\"outline: 0px; margin-bottom: 16px; font-size: 16px; color: rgb(77, 77, 77); overflow: auto hidden; overflow-wrap: break-word; font-family: -apple-system, &quot;SF UI Text&quot;, Arial, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei&quot;, &quot;WenQuanYi Micro Hei&quot;, sans-serif, SimHei, SimSun; line-height: 26px !important;\">启动完成后，使用IP+端口访问（默认用户名：admin，密码：123456；数据库用户：root，默认密码：123456），地址：<a href=\"http://ip:8183\">http://ip:8183</a><a href=\"http://localhost:8183/\" style=\"outline: none; margin: 0px; padding: 0px; cursor: pointer; color: rgb(78, 161, 219); overflow-wrap: break-word;\"></a></p><p style=\"outline: 0px; margin-bottom: 16px; overflow: auto hidden; overflow-wrap: break-word; line-height: 26px !important;\"><font color=\"#4d4d4d\" face=\"-apple-system, SF UI Text, Arial, PingFang SC, Hiragino Sans GB, Microsoft YaHei, WenQuanYi Micro Hei, sans-serif, SimHei, SimSun\"><span style=\"font-size: 16px;\">https://img-blog.csdnimg.cn/20210816150103901.png?x-oss-process=image/watermark,type_ZmFuZ3poZW5naGVpdGk,shadow_10,text_aHR0cHM6Ly9ibG9nLmNzZG4ubmV0L3FxXzI2MjMwNDIx,size_16,color_FFFFFF,t_70</span></font><br></p><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><br></p></div><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><br></p>' , `article_guide` = 8 , `article_label` = 'php;linux' , `article_img` = '/uploads/20220226/00e2aa01ef0426c50f805bc84e8a0b8f.png' , `is_show` = 1 , `click_num` = 23 , `is_top_show` = 0 , `update_time` = 1645867413  WHERE  `article_id` = 53 [ RunTime:0.010137s ]
