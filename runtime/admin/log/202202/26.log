[2022-02-26T17:05:25+08:00][sql] INSERT INTO `carver_article` SET `article_title` = 'Linux——安装docker以及docker常用命令' , `article_label` = 'linux' , `article_desc` = 'Linux——安装docker以及docker常用命令' , `article_content` = '<h1 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 700; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 24px; color: rgb(79, 79, 79); line-height: 32px; overflow-wrap: break-word;\">一、安装依赖包</h1><pre style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>yum install -y yum-utils device-mapper-persistent-data lvm2</b></span></font></pre><h1 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 700; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 24px; color: rgb(79, 79, 79); line-height: 32px; overflow-wrap: break-word;\">二、设置阿里云镜像源</h1><pre style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>yum-config-manager --add-repo </b></span></font><a href=\"https://mirrors.aliyun.com/docker-ce/linux/centos/docker-ce.repo\">https://mirrors.aliyun.com/docker-ce/linux/centos/docker-ce.repo</a></pre><h1 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 700; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 24px; color: rgb(79, 79, 79); line-height: 32px; overflow-wrap: break-word;\">三、安装 Docker-CE</h1><pre style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>yum install -y docker-ce</b></span></font></pre><h1 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 700; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 24px; color: rgb(79, 79, 79); line-height: 32px; overflow-wrap: break-word;\">四、启动docker服务</h1><pre style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>service docker start</b></span></font></pre><h1 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 700; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 24px; color: rgb(79, 79, 79); line-height: 32px; overflow-wrap: break-word;\">五、设置docker开机自启动</h1><pre style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>systemctl enable docker</b></span></font></pre><h1 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 700; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 24px; color: rgb(79, 79, 79); line-height: 32px; overflow-wrap: break-word;\">六、docker基本命令</h1><h2 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>docker重启动：docker restart docker容器id</b></span></font></h2><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>查看运行的容器：docker ps 【正在运行的docker容器】</b></span></font></p><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>查看所有的容器：docker ps -a【包含已经停止的容器】</b></span></font></p><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><b style=\"font-size: 24px; color: rgb(79, 79, 79); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun;\">指定容器启动：docker start -i docker容器id</b><br></p><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><b style=\"font-size: 24px; color: rgb(79, 79, 79); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun;\">开机启动docker容器：docker update --restart=always docker容器id</b><br></p><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>删除docker容器：docker rm docker容器id</b></span></font></p><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><b style=\"font-size: 24px; color: rgb(79, 79, 79); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun;\">守护式容器快捷退出键：CTRL+Q CTRL+P【此快捷键退出后，程序后台正常运行】</b><br></p><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px;\"><b>进入docker容器：docker exec -it docker容器id /bin/bash</b></span></font></p><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"><br></p>' , `article_guide` = 8 , `click_num` = 233 , `article_img` = '/uploads/20220226/d531fc345cc3b950220fed3a7ce920fc.png' , `is_show` = 0 , `is_top_show` = 0 , `article_author` = 'lijialong' , `add_time` = 1645866325 , `update_time` = 1645866325 [ RunTime:0.005854s ]
