[2022-02-26T20:38:52+08:00][sql] UPDATE `carver_article`  SET `article_id` = 6 , `article_title` = '将一个二维数组合并成一个一维数组' , `article_desc` = '将一个二维数组合并成一个一维数组' , `article_content` = '<div>&lt;?php</div><div>&nbsp;</div><div>&nbsp; &nbsp; Class Category{</div><div>&nbsp;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; //一维数组无限级分类</div><div>&nbsp; &nbsp; &nbsp; &nbsp; Static Public function yiwei($cate,$pid=0){</div><div>&nbsp;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; $arr=array();</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; foreach($cate as $v){</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if($v[\'pid\'] == $pid){</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; $arr[]=$v;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; $arr=array_merge($arr,self::yiwei($cate,$v[\'id\']));</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return $arr;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; //二位数组无限级分类</div><div>&nbsp; &nbsp; &nbsp; &nbsp; Static Public function erwei($cate,$pid=0){</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; $arr=array();</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; foreach($cate as $v){</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if($v[\'pid\'] == $pid){</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; $v[\'child\']=self::erwei($cate,$v[\'id\']);</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; $arr[]=$v;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return $arr;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp;</div><div>&nbsp;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; //通过子级寻找父级</div><div>&nbsp; &nbsp; &nbsp; &nbsp; Static Public function findFather($cate,$id){</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; $arr=array();</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; foreach($cate as $v){</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if($v[\'id\'] == $id){</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; $arr[]=$v;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; $arr=array_merge($arr,self::findFather($cate,$v[\'pid\']));</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return $arr;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; //通过父级寻找子级</div><div>&nbsp; &nbsp; &nbsp; &nbsp; Static Public function findChild($cate,$pid){</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; $arr=array();</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; foreach($cate as $v){</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if($v[\'pid\'] == $pid){</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; $arr[]=$v[\'id\'];</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; $arr=array_merge($arr,self::findChild($cate,$v[\'id\']));</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return $arr;</div><div>&nbsp; &nbsp; &nbsp; &nbsp; }</div><div>&nbsp; &nbsp; }</div><div>?&gt;</div>' , `article_guide` = 0 , `article_label` = 'php' , `article_img` = '/uploads/20210813/5bef5dc3e982decfe95c9aef4cded654.jpeg' , `is_show` = 1 , `click_num` = 14 , `is_top_s