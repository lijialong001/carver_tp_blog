[2022-02-26T18:07:07+08:00][sql] INSERT INTO `carver_article` SET `article_title` = 'Linux——不同服务器之间的远程传输文件命令' , `article_label` = 'php;linux' , `article_desc` = 'Linux——不同服务器之间的远程传输文件命令' , `article_content` = '<div>有时候，我们在很多情况下会搭建集群，比如redis等等；<br></div><div><br></div><div>这中间会有很大的重复的工作！</div><div><br></div><div>为了缩小工作量，减少没必要的时间，</div><div><br></div><div>我们可以使用下面的命令，来复制已经安装好的软件</div><div><br></div><div>然后把配置文件修改一下就可以了：</div><div><br></div><div>命令</div><pre>scp&nbsp; -r&nbsp; 本地文件所在路径&nbsp; 远程IP:文件放置路径</pre><div><br></div><div>例如：</div><pre>scp -r redis 测试ip:/usr/local/</pre><div><br></div><div>这样就会把redis这个文件夹复制到测试ip的服务器之中！</div><div><br></div><div>当然，也可以反过来操作，把远程服务器的文件放到本地</div><div><br></div><div>scp&nbsp; 远程主机名@远程IP:文件所在路径&nbsp; 本地文件放置路径&nbsp;</div><div><br></div><div>例如：scp root@<a class=\"btlink click_name_baYeB_name\" title=\"101.200.121.249\" style=\"background-color: rgb(255, 255, 255); color: rgb(32, 165, 58); border: 0px; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); word-break: break-word; font-family: 微软雅黑, Arial, Helvetica, sans-serif;\">101.200.121.249</a>:/usr/local/&nbsp; /usr/local/redis</div><div><br></div>' , `article_guide` = 8 , `click_num` = 233 , `article_img` = '/uploads/20220226/f53144e1abc4474ec65642232f03efda.png' , `is_show` = 1 , `is_top_show` = 0 , `article_author` = 'lijialong' , `add_time` = 1645870027 , `update_time` = 1645870027 [ RunTime:0.007816s ]
