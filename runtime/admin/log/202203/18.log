[2022-03-18T17:17:46+08:00][sql] UPDATE `carver_article`  SET `article_id` = 71 , `article_title` = 'TP6.0调试模式下关闭Trace调试' , `article_desc` = 'TP6.0调试模式下关闭Trace调试' , `article_content` = '<h4 id=\"1-在-tp60-当前最新版-v607-中\" style=\"margin-top: 10px; margin-bottom: 10px; font-size: 14px; font-weight: bold; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif;\">之前发布的项目没有关闭调试模式哦：</h4><h4 id=\"1-在-tp60-当前最新版-v607-中\" style=\"margin-top: 10px; margin-bottom: 10px; font-size: 14px; font-weight: bold; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif;\">1. 在 TP6.0 当前最新版 (v6.0.7) 中</h4><hr style=\"margin-top: 5px; margin-bottom: 5px; padding: 0px; border-top: rgb(136, 136, 136); color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px; background-color: rgb(255, 255, 255);\"><p style=\"margin: 10px auto; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px;\">默认安装的时候会自动安装&nbsp;<code style=\"margin: 0px 3px; padding: 0px 5px; font-family: &quot;Courier New&quot;, sans-serif; font-size: 12px; line-height: 1.8; display: inline-block; overflow-x: auto; vertical-align: middle; border-radius: 3px; background-color: rgb(246, 246, 246); color: rgb(232, 62, 140);\"><b>topthink/think-trace</b></code>&nbsp;扩展</p><p style=\"margin: 10px auto; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px;\">在调试模式下浏览器右下角会出现trace信息, 此时无法手动关闭 Trace 调试, 只有切换到部署模式 trace 调试才会关闭</p><h4 id=\"2-如何在调试模式下关闭-trace-调试\" style=\"margin-top: 10px; margin-bottom: 10px; font-size: 14px; font-weight: bold; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif;\">2. 如何在调试模式下关闭 trace 调试</h4><hr style=\"margin-top: 5px; margin-bottom: 5px; padding: 0px; border-top: rgb(136, 136, 136); color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px; background-color: rgb(255, 255, 255);\"><p style=\"margin: 10px auto; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px;\">在TP6.0最新版中, 调试模式下是无法关闭 trace 调试的</p><p style=\"margin: 10px auto; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px;\">但是可以通过移除&nbsp;<code style=\"margin: 0px 3px; padding: 0px 5px; font-family: &quot;Courier New&quot;, sans-serif; font-size: 12px; line-height: 1.8; display: inline-block; overflow-x: auto; vertical-align: middle; border-radius: 3px; background-color: rgb(246, 246, 246); color: rgb(232, 62, 140);\"><b>topthink/think-trace</b></code>&nbsp;扩展来关闭 trace 信息</p><p style=\"margin: 10px auto; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px;\">通过查看框架根目录下的&nbsp;<code style=\"margin: 0px 3px; padding: 0px 5px; font-family: &quot;Courier New&quot;, sans-serif; font-size: 12px; line-height: 1.8; display: inline-block; overflow-x: auto; vertical-align: middle; border-radius: 3px; background-color: rgb(246, 246, 246); color: rgb(232, 62, 140);\"><b>composer.json</b></code>&nbsp;可发现该扩展在&nbsp;<code style=\"margin: 0px 3px; padding: 0px 5px; font-family: &quot;Courier New&quot;, sans-serif; font-size: 12px; line-height: 1.8; display: inline-block; overflow-x: auto; vertical-align: middle; border-radius: 3px; background-color: rgb(246, 246, 246); color: rgb(232, 62, 140);\"><b>require-dev</b></code>&nbsp;中</p><pre highlighted=\"true\" has-selection=\"true\" style=\"margin-top: 10px; margin-right: auto; margin-left: auto; padding: 0px; transition-duration: 0.2s; transition-property: color, opacity; font-size: 14px; background-color: rgb(255, 255, 255);\"><code class=\"language-json hljs\" style=\"margin: 0px; padding: 1em; font-family: &quot;Courier New&quot;, sans-serif; transition-duration: 0.2s; transition-property: color, opacity, border-color; background: rgb(245, 245, 245); color: rgb(68, 68, 68); display: block; font-size: 13px; border: 1px solid rgb(204, 204, 204); border-radius: 3px; overflow-x: auto; line-height: 1.5;\"><span class=\"hljs-attr\" style=\"margin: 0px; padding: 0px; transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(255, 0, 0);\">\"require-dev\"</span><span class=\"hljs-punctuation\" style=\"margin: 0px; padding: 0px; transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(68, 74, 68);\">:</span> <span class=\"hljs-punctuation\" style=\"margin: 0px; padding: 0px; transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(68, 74, 68);\">{</span>
    <span class=\"hljs-attr\" style=\"margin: 0px; padding: 0px; transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(255, 0, 0);\">\"topthink/think-trace\"</span><span class=\"hljs-punctuation\" style=\"margin: 0px; padding: 0px; transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(68, 74, 68);\">:</span> <span class=\"hljs-string\" style=\"margin: 0px; padding: 0px; transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(163, 21, 21);\">\"^1.4\"</span>
<span class=\"hljs-punctuation\" style=\"margin: 0px; padding: 0px; transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(68, 74, 68);\">}</span><span class=\"hljs-punctuation\" style=\"margin: 0px; padding: 0px; transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(68, 74, 68);\">,</span>
</code></pre><p style=\"margin: 10px auto; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px;\">移除&nbsp;<code style=\"margin: 0px 3px; padding: 0px 5px; font-family: &quot;Courier New&quot;, sans-serif; font-size: 12px; line-height: 1.8; display: inline-block; overflow-x: auto; vertical-align: middle; border-radius: 3px; background-color: rgb(246, 246, 246); color: rgb(232, 62, 140);\"><b>require-dev</b></code>&nbsp;中的扩展包需要添加&nbsp;<code style=\"margin: 0px 3px; padding: 0px 5px; font-family: &quot;Courier New&quot;, sans-serif; font-size: 12px; line-height: 1.8; display: inline-block; overflow-x: auto; vertical-align: middle; border-radius: 3px; background-color: rgb(246, 246, 246); color: rgb(232, 62, 140);\"><b>--dev</b></code>&nbsp;参数</p><pre highlighted=\"true\" has-selection=\"true\" style=\"margin-top: 10px; margin-right: auto; margin-left: auto; padding: 0px; transition-duration: 0.2s; transition-property: color, opacity; font-size: 14px; background-color: rgb(255, 255, 255);\"><code class=\"hljs language-lua\" style=\"margin: 0px; padding: 1em; font-family: &quot;Courier New&quot;, sans-serif; transition-duration: 0.2s; transition-property: color, opacity, border-color; background: rgb(245, 245, 245); color: rgb(68, 68, 68); display: block; font-size: 13px; border: 1px solid rgb(204, 204, 204); border-radius: 3px; overflow-x: auto; line-height: 1.5;\">composer <span class=\"hljs-built_in\" style=\"margin: 0px; padding: 0px; transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(0, 0, 255);\">remove</span> topthink/think-trace <span class=\"hljs-comment\" style=\"margin: 0px; padding: 0px; transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(0, 128, 0);\">--dev</span>
</code></pre><p style=\"margin: 10px auto; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px;\">如果需要再次使用 trace 调试，重新引入扩展即可</p><pre highlighted=\"true\" has-selection=\"true\" cnb-code-toolbar-active=\"true\" style=\"margin-top: 10px; margin-right: auto; margin-left: auto; padding: 0px; transition-duration: 0.2s; transition-property: color, opacity; position: relative; font-size: 14px; background-color: rgb(255, 255, 255);\"><code class=\"hljs language-lua\" style=\"margin: 0px; padding: 1em; font-family: &quot;Courier New&quot;, sans-serif; transition-duration: 0.2s; transition-property: color, opacity, border-color; background: rgb(245, 245, 245); color: rgb(68, 68, 68); display: block; font-size: 13px; border: 1px solid rgb(204, 204, 204); border-radius: 3px; overflow-x: auto; line-height: 1.5;\">composer <span class=\"hljs-built_in\" style=\"margin: 0px; padding: 0px; transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(0, 0, 255);\">require</span> topthink/think-trace <span class=\"hljs-comment\" style=\"margin: 0px; padding: 0px; transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(0, 128, 0);\">--dev</span></code></pre>' , `article_guide` = 5 , `article_label` = 'php;thinkphp;php' , `article_img` = '/uploads/20220318/94d72a21b025f507d759ff61564ed5fb.png' , `is_show` = 1 , `click_num` = 1323 , `is_top_show` = 0 , `update_time` = 1647595066  WHERE  `article_id` = 71 [ RunTime:0.009541s ]
