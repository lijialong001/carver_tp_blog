[2022-03-18T15:09:00+08:00][sql] UPDATE `carver_article`  SET `article_id` = 70 , `article_title` = '解决docker-compose 命令不存在、未找到命令错误' , `article_desc` = '解决docker-compose 命令不存在、未找到命令错误' , `article_content` = '<h2 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 600; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 22px; color: rgb(79, 79, 79); line-height: 30px; overflow-wrap: break-word; font-variant-ligatures: no-common-ligatures;\">安装扩展源：</h2><pre style=\"margin-top: 8px; margin-bottom: 16px; line-height: 30px; outline: 0px;\">sudo yum -y install epel-release</pre><h2 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 600; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 22px; color: rgb(79, 79, 79); line-height: 30px; overflow-wrap: break-word; font-variant-ligatures: no-common-ligatures;\">安装python-pip模块：</h2><pre style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 30px; overflow-wrap: break-word;\">sudo yum install python-pip</pre><h2 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 600; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 22px; color: rgb(79, 79, 79); line-height: 30px; overflow-wrap: break-word; font-variant-ligatures: no-common-ligatures;\">查看docker-compose版本,提示未找到命令:</h2><pre style=\"margin-top: 8px; margin-bottom: 16px; line-height: 30px; outline: 0px;\">docker-compose version</pre><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 600; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 22px; color: rgb(79, 79, 79); line-height: 30px; overflow-wrap: break-word; font-variant-ligatures: no-common-ligatures;\"><img src=\"https://img-blog.csdnimg.cn/img_convert/22b0a713883838c4f54b855e09d0c351.png\" alt=\"image.png\"><br></p><h2 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 600; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 22px; color: rgb(79, 79, 79); line-height: 30px; overflow-wrap: break-word; font-variant-ligatures: no-common-ligatures;\">通过命令进行安装:</h2><pre style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 30px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 22px; font-variant-ligatures: no-common-ligatures;\"><b>进入目录： cd /usr/local/bin/</b></span></font></pre><pre style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 30px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 22px; font-variant-ligatures: no-common-ligatures;\"><b>wget https://github.com/docker/compose/releases/download/1.14.0-rc2/docker-compose-Linux-x86_64</b></span></font></pre><pre style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 30px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 22px; font-variant-ligatures: no-common-ligatures;\"><b>rename docker-compose-Linux-x86_64 docker-compose docker-compose-Linux-x86_64</b></span></font></pre><pre style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 30px; overflow-wrap: break-word;\"><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 22px; font-variant-ligatures: no-common-ligatures;\"><b>chmod +x /usr/local/bin/docker-compose</b></span></font></pre><h2 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 600; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 22px; color: rgb(79, 79, 79); line-height: 30px; overflow-wrap: break-word; font-variant-ligatures: no-common-ligatures;\">docker-compose version命令进行查看:</h2><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 600; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 22px; color: rgb(79, 79, 79); line-height: 30px; overflow-wrap: break-word; font-variant-ligatures: no-common-ligatures;\"><img src=\"https://img-blog.csdnimg.cn/img_convert/8150b5116da4e45ab0aef5965e78996b.png\" alt=\"image.png\"><br></p><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 600; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 22px; color: rgb(79, 79, 79); line-height: 30px; overflow-wrap: break-word; font-variant-ligatures: no-common-ligatures;\">后面会出现docker-compose的版本太低的情况：</p><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 600; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 22px; color: rgb(79, 79, 79); line-height: 30px; overflow-wrap: break-word; font-variant-ligatures: no-common-ligatures;\"><img src=\"data:image/png;base64,\" data-filename=\"banben.png\" style=\"width: 829px;\"><br></p><p style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 22px; color: rgb(79, 79, 79); line-height: 30px; overflow-wrap: break-word; font-variant-ligatures: no-common-ligatures;\">首先</p><p style=\"margin-top: 8px; margin-bottom: 16px; outline: 0px; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 22px; color: rgb(79, 79, 79); line-height: 30px; overflow-wrap: break-word; font-variant-ligatures: no-common-ligatures;\"><span style=\"color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px; font-variant-ligatures: normal;\"><b>运行以下命令，下载Docker Compose的当前稳定版本</b></span><br></p><pre style=\"margin-top: 8px; margin-bottom: 16px; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 22px; line-height: 30px; color: rgb(79, 79, 79); outline: 0px; font-variant-ligatures: no-common-ligatures;\"><span class=\"language-bash\" style=\"transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(68, 68, 68); font-family: &quot;Courier New&quot;, sans-serif; font-size: 13px; font-variant-ligatures: normal;\"><span class=\"hljs-built_in\" style=\"transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(0, 0, 255);\">mkdir</span> -p /usr/local/bin/docker/cli-plugins<br></span><span class=\"hljs-meta\" style=\"transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(43, 145, 175); font-family: &quot;Courier New&quot;, sans-serif; font-size: 13px; font-variant-ligatures: normal;\">$ </span><span class=\"language-bash\" style=\"transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity; color: rgb(68, 68, 68); font-family: &quot;Courier New&quot;, sans-serif; font-size: 13px; font-variant-ligatures: normal;\">curl -SL https://github.com/docker/compose/releases/download/v2.2.2/docker-compose-linux-x86_64 -o /usr/local/bin/docker/cli-plugins/docker-compose</span></pre><p style=\"margin: 10px auto; line-height: 1.5; padding: 10px; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px;\">或者可以从下面页下载稳定版&nbsp;<a href=\"https://github.com/docker/compose/releases/download/v2.2.2/docker-compose-linux-x86_64\" target=\"_blank\" rel=\"noopener\" style=\"background: none rgb(255, 255, 255); color: rgb(255, 0, 0); font-weight: bold; text-decoration-line: underline;\">docker-compose-linux-x86_64</a></p><p style=\"margin: 10px auto; line-height: 1.5; padding: 10px; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px;\"><a href=\"https://github.com/docker/compose/releases\">https://github.com/docker/compose/releases</a><a href=\"https://github.com/docker/compose/releases\" target=\"_blank\" rel=\"noopener\" style=\"color: rgb(51, 102, 204);\"></a></p><p style=\"margin: 10px auto; line-height: 1.5; padding: 10px; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px;\">上传到 /usr/local/bin/docker/cli-plugins/ 目录下 并且修改 docker-compose-linux-x86_64 文件名为 docker-compose</p><h4 style=\"margin: 10px auto; line-height: 1.5; padding: 10px; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px;\"><span style=\"font-size: 12px; font-weight: bold;\">对二进制文件应用可执行权限</span></h4><pre style=\"margin: 10px auto; line-height: 1.5; padding: 10px;\">chmod +x /usr/local/bin/docker/cli-plugins/docker-compose</pre><p style=\"margin: 10px auto; line-height: 1.5; padding: 10px; color: rgb(51, 51, 51); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 14px;\"><b>测试安装</b></p><pre style=\"margin: 10px auto; line-height: 1.5; padding: 10px;\"><span class=\"language-bash\" style=\"transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity;\">docker compose version</span></pre><p style=\"margin: 10px auto; line-height: 1.5; padding: 10px;\"><span class=\"language-bash\" style=\"transition-duration: 0.2s; transition-property: background-color, border-color, border-radius, padding, margin, color, opacity;\"><br></span>&nbsp;显示版本为&nbsp; Docker Compose version v2.2.2</p>' , `article_guide` = 8 , `article_label` = 'php;linux;docker' , `article_img` = '/uploads/20220318/166f1ccdf70910d06fa22419f36b2a2c.png' , `is_show` = 1 , `click_num` = 1872 , `is_top_show` = 0 , `update_time` = 1647587340  WHERE  `article_id` = 70 [ RunTime:0.038462s ]
