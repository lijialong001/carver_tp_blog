[2022-03-15T13:33:05+08:00][sql] UPDATE `carver_article`  SET `article_id` = 65 , `article_title` = '记录redis \"Connection timed out\"处理 ' , `article_desc` = '记录redis \"Connection timed out\"处理 ' , `article_content` = '<p><span style=\"color: rgb(77, 77, 77); font-family: -apple-system, &quot;SF UI Text&quot;, Arial, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei&quot;, &quot;WenQuanYi Micro Hei&quot;, sans-serif, SimHei, SimSun; font-size: 16px;\">redis已经加入到etc下也就是服务器启动redis 也启动。突然发现连不上redis 所以上来看看<br></span></p><p><span style=\"color: rgb(77, 77, 77); font-family: -apple-system, &quot;SF UI Text&quot;, Arial, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei&quot;, &quot;WenQuanYi Micro Hei&quot;, sans-serif, SimHei, SimSun; font-size: 16px;\">查看redis 状态：</span></p><p></p><pre><span style=\"color: rgb(77, 77, 77); font-family: -apple-system, &quot;SF UI Text&quot;, Arial, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei&quot;, &quot;WenQuanYi Micro Hei&quot;, sans-serif, SimHei, SimSun; font-size: 16px;\"><b>systemctl status redis</b></span></pre><font color=\"#4d4d4d\" face=\"-apple-system, SF UI Text, Arial, PingFang SC, Hiragino Sans GB, Microsoft YaHei, WenQuanYi Micro Hei, sans-serif, SimHei, SimSun\"><span style=\"font-size: 16px;\"><br></span></font><img src=\"data:image/png;base64,\" alt=\"\"><img src=\"data:image/png;base64,\" style=\"width: 828px;\" data-filename=\"image.png\">正常启动哦<p></p><p><br></p><p><span style=\"color: rgb(77, 77, 77); font-family: -apple-system, &quot;SF UI Text&quot;, Arial, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei&quot;, &quot;WenQuanYi Micro Hei&quot;, sans-serif, SimHei, SimSun; font-size: 16px;\">启动后再看看状态：</span></p><pre><span style=\"color: rgb(77, 77, 77); font-family: -apple-system, &quot;SF UI Text&quot;, Arial, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei&quot;, &quot;WenQuanYi Micro Hei&quot;, sans-serif, SimHei, SimSun; font-size: 16px;\"><b>systemctl start redis</b></span></pre><p><font color=\"#4d4d4d\" face=\"-apple-system, SF UI Text, Arial, PingFang SC, Hiragino Sans GB, Microsoft YaHei, WenQuanYi Micro Hei, sans-serif, SimHei, SimSun\"><span style=\"font-size: 16px;\"><br></span></font><img src=\"data:image/png;base64,\" alt=\"\"><img src=\"data:image/png;base64,\" style=\"width: 828px;\" data-filename=\"image.png\"><font color=\"#4d4d4d\" face=\"-apple-system, SF UI Text, Arial, PingFang SC, Hiragino Sans GB, Microsoft YaHei, WenQuanYi Micro Hei, sans-serif, SimHei, SimSun\"><span style=\"font-size: 16px;\"><br></span></font></p><p><span style=\"color: rgb(77, 77, 77); font-family: -apple-system, &quot;SF UI Text&quot;, Arial, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei&quot;, &quot;WenQuanYi Micro Hei&quot;, sans-serif, SimHei, SimSun; font-size: 16px;\">重启redis：</span></p><pre><span style=\"color: rgb(77, 77, 77); font-family: -apple-system, &quot;SF UI Text&quot;, Arial, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei&quot;, &quot;WenQuanYi Micro Hei&quot;, sans-serif, SimHei, SimSun; font-size: 16px;\"><b>systemctl restart redis.service</b></span></pre><p><span style=\"color: rgb(77, 77, 77); font-family: -apple-system, &quot;SF UI Text&quot;, Arial, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei&quot;, &quot;WenQuanYi Micro Hei&quot;, sans-serif, SimHei, SimSun; font-size: 16px;\"><b><br></b></span><font color=\"#4d4d4d\" face=\"-apple-system, SF UI Text, Arial, PingFang SC, Hiragino Sans GB, Microsoft YaHei, WenQuanYi Micro Hei, sans-serif, SimHei, SimSun\"><span style=\"font-size: 16px;\">结果还是不行，想不到还是安全组没有开启对应的端口，万万没想到，我都懵了：</span></font></p><p><img src=\"data:image/png;base64,\" alt=\"\"><img src=\"data:image/png;base64,\" data-filename=\"image.png\" style=\"width: 828px;\"><font color=\"#4d4d4d\" face=\"-apple-system, SF UI Text, Arial, PingFang SC, Hiragino Sans GB, Microsoft YaHei, WenQuanYi Micro Hei, sans-serif, SimHei, SimSun\"><span style=\"font-size: 16px;\"><br></span></font></p><p><font color=\"#4d4d4d\" face=\"-apple-system, SF UI Text, Arial, PingFang SC, Hiragino Sans GB, Microsoft YaHei, WenQuanYi Micro Hei, sans-serif, SimHei, SimSun\"><span style=\"font-size: 16px;\"><br></span></font></p><p><font color=\"#4d4d4d\" face=\"-apple-system, SF UI Text, Arial, PingFang SC, Hiragino Sans GB, Microsoft YaHei, WenQuanYi Micro Hei, sans-serif, SimHei, SimSun\"><span style=\"font-size: 16px;\"><br></span></font></p>' , `article_guide` = 8 , `article_label` = 'linux' , `article_img` = '/uploads/20220315/003f0b3c9815a21ed75f56c4b68fe1db.png' , `is_show` = 1 , `click_num` = 23 , `is_top_show` = 0 , `update_time` = 1647322385  WHERE  `article_id` = 65 [ RunTime:0.061518s ]
