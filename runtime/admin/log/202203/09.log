ligatures: no-common-ligatures;\">$excel&nbsp; = new \\Vtiful\\Kernel\\Excel($config);</span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\"><br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">// fileName 会自动创建一个工作表，你可以自定义该工作表名称，工作表名称为可选参数<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">$filePath = $excel-&gt;fileName(\'tutorial01.xlsx\', \'sheet1\')<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">&nbsp; &nbsp; -&gt;header([\'Item\', \'Cost\'])<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">&nbsp; &nbsp; -&gt;data([<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">&nbsp; &nbsp; &nbsp; &nbsp; [\'Rent\', 1000],<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">&nbsp; &nbsp; &nbsp; &nbsp; [\'Gas\',&nbsp; 100],<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">&nbsp; &nbsp; &nbsp; &nbsp; [\'Food\', 300],<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">&nbsp; &nbsp; &nbsp; &nbsp; [\'Gym\',&nbsp; 50],<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">&nbsp; &nbsp; ])<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">&nbsp; &nbsp; -&gt;output();</span></font></pre><h4></h4><div><br></div><h4><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\"><br></span></font></h4><h4><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">2.&gt;导入文件</span></font></h4><h4><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\"><br></span></font></h4><pre><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">$config&nbsp; &nbsp;= [\'path\' =&gt; \'./tests\'];<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">$excel&nbsp; &nbsp; = new \\Vtiful\\Kernel\\Excel($config);</span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\"><br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">// 导出测试文件<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microso