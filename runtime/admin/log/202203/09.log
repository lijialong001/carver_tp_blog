[2022-03-09T00:12:33+08:00][sql] UPDATE `carver_article`  SET `article_id` = 58 , `article_title` = 'PHP导出/导入Excel 扩展 XLSWriter' , `article_desc` = 'PHP导出/导入Excel 扩展 XLSWriter' , `article_content` = '<h1 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; font-weight: 600; font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, SimHei, Arial, SimSun; font-size: 24px; color: rgb(79, 79, 79); line-height: 32px; overflow-wrap: break-word; font-variant-ligatures: no-common-ligatures;\">windows安装:<br></h1><h5 style=\"outline: 0px; margin-top: 8px; margin-bottom: 16px; line-height: 32px; overflow-wrap: break-word;\"></h5><h4><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">1.选择对应版本下载<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">https://pecl.php.net/package/xlswriter<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">https://pecl.php.net/package/xlswriter/1.3.7/windows<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">2.解压<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">3.将php_xlswriter.dll、php_xlswriter.pdb放在PHP的ext目录</span></font></h4><h4><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, SimSun\"><span style=\"font-size: 24px; font-variant-ligatures: no-common-ligatures;\">4.在php.ini中增加extension=xlswriter<br></span></font><font color=\"#4f4f4f\" face=\"PingFang SC, Microsoft YaHei, SimHei, Arial, Si