</span><span style=\"color: rgb(0, 0, 255); line-height: 1.5 !important;\">grant</span> <span style=\"color: rgb(0, 0, 255); line-height: 1.5 !important;\">drop</span> <span style=\"color: rgb(0, 0, 255); line-height: 1.5 !important;\">on</span> testdb.<span style=\"color: rgb(128, 128, 128); line-height: 1.5 !important;\">*</span> <span style=\"color: rgb(0, 0, 255); line-height: 1.5 !important;\">to</span> developer@’<span style=\"color: rgb(128, 0, 0); font-weight: bold; line-height: 1.5 !important;\">192.168</span>.<span style=\"color: rgb(128, 0, 0); font-weight: bold; line-height: 1.5 !important;\">0</span>.<span style=\"color: rgb(128, 128, 128); line-height: 1.5 !important;\">%</span><span style=\"line-height: 1.5 !important;\">’;
