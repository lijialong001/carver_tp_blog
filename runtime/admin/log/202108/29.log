[2021-08-29T14:22:49+08:00][sql] INSERT INTO `carver_article` SET `article_title` = 'PHP获取重定向URL的几种方法' , `article_label` = 'php' , `article_desc` = 'PHP获取重定向URL的几种方法' , `article_content` = '<p style=\"margin: 10px auto; color: rgb(94, 94, 94); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\">1、用get_headers函数<br>php自带的get_headers函数可以获取服务器响应一个HTTP请求所发送的所有标头，我们可以尝试用该函数实现。</p><pre style=\"margin: 10px auto; color: rgb(94, 94, 94); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\">function get_redirect_url($url){<br>$header = get_headers($url, 1);<br>if (strpos($header[0], ’301′) !== false || strpos($header[0], ’302′) !== false) {<br>if(is_array($header[\'Location\'])) {<br>return $header[\'Location\'][count($header[\'Location\'])-1];<br>}else{<br>return $header[\'Location\'];<br>}<br>}else {<br>return $url;<br>}<br>}</pre><p style=\"margin: 10px auto; color: rgb(94, 94, 94); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\"><br></p><p style=\"margin: 10px auto; color: rgb(94, 94, 94); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\">2、使用cURL函数</p><pre style=\"margin: 10px auto; color: rgb(94, 94, 94); font-family: &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 13px; text-align: justify;\">function get_redirect_url($url, $referer=”, $timeout = 10) {<br>$redirect_url = false;<br>$ch = curl_init();<br>curl_setopt($ch, CURLOPT_URL, $url);<br>curl_setopt($ch, CURLOPT_HEADER, TRUE);<br>curl_setopt($ch, CURLOPT_NOBODY, TRUE);//不返回请求体内容<br>curl_setopt($ch, CURLOPT_FOLLOWLOCATION, TRUE);//允许请求的链接跳转<br>curl_setopt($ch, CURLOPT_RETURNTRANSFER, TRUE);<br>curl_setopt($ch, CURLOPT_TIMEOUT, $timeout);<br>curl_setopt($ch, CURLOPT_HTTPHEADER, array(<br>‘Accept: */*’,<br>‘User-Agent: Mozilla/4.0 (compatible; MSIE 6.0; Windows NT 5.1; SV1)’,<br>‘Connection: Keep-Alive’));<br>if ($referer) {<br>curl_setopt($ch, CURLOPT_REFERER, $referer);//设置referer<br>}<br>$content = curl_exec($ch);<br>if(!curl_errno($ch)) {<br>$redirect_url = curl_getinfo($ch, CURLINFO_EFFECTIVE_URL);//获取最终请求的url地址<br>}<br>return $redirect_url;<br>}</pre>' , `article_guide` = 5 , `click_num` = 1 , `article_img` = '/uploads/20210829/43454aceed80e5821f913982bdc39d2d.jpeg' , `is_show` = 0 , `is_top_show` = 0 , `article_author` = 'lijialong' , `add_time` = 1630218169 , `update_time` = 1630218169 [ RunTime:0.009721s ]
