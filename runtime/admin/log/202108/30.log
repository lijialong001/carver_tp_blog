ourier New&quot; !important;\"><span style=\"color: rgb(0, 0, 255); line-height: 1.5 !important;\">grant</span> <span style=\"color: rgb(0, 0, 255); line-height: 1.5 !important;\">select</span> <span style=\"color: rgb(0, 0, 255); line-height: 1.5 !important;\">on</span> admindb.<span style=\"color: rgb(128, 128, 128); line-height: 1.5 !important;\">*</span> <span style=\"color: rgb(0, 0, 255); line-height: 1.5 !important;\">to</span> common_user@’<span style=\"color: rgb(128, 128, 128); line-height: 1.5 !important;\">%</span><span style=\"line-height: 1.5 !important;\">’
