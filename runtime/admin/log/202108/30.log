[2021-08-30T22:50:25+08:00][sql] INSERT INTO `carver_article` SET `article_title` = 'Mysql 设置用户权限' , `article_label` = 'php;mysql' , `article_desc` = 'Mysql 设置用户权限' , `article_content` = '<p><b>一：mysql 的数据库中用户权限操作</b></p><p><b><br></b></p><p><b>1.添加用户：</b></p><p><b>create user \'username\'@\'ip地址\' identified by \'密码\'&nbsp; （ip地址所选范围： %为所有ip&nbsp; &nbsp;localhost 只为本地连接）</b></p><p><b><br></b></p><h1><b>注意：创建用户后需要刷新权限：</b><span style=\"background-color: rgb(245, 245, 245); font-family: &quot;Courier New&quot;; white-space: pre-wrap;\"><b>flush privileges;</b></span></h1><p><b><br></b></p><p><b>2.更新用户名或者ip：</b></p><p><b>rename user \'旧的用户名\'@\'旧的ip地址\'&nbsp; to&nbsp;</b><b>\'新的用户名\'@\'新的ip地址\'</b></p><p><b><br></b></p><p><b>3.登录用户：</b></p><p><b>mysql&nbsp; -u用户名 -p<span style=\"background-color: rgb(255, 0, 0);\">IP地址</span> -p&nbsp; &nbsp; &nbsp;（&nbsp;</b><b>注意：创建指定ip地址的用户，登录时需要指定对应的ip地址&nbsp;</b><b>）</b></p><p><b><br></b></p><p><b><br></b></p><p><br></p><p><b><br></b></p>' , `article_guide` = 5 , `click_num` = 1 , `article_img` = '/uploads/20210830/f6a52aa850940a5e2aa994987573b05e.jpeg' , `is_show` = 0 , `is_top_show` = 0 , `article_author` = 'lijialong' , `add_time` = 1630335025 , `update_time` = 1630335025 [ RunTime:0.008068s ]
